    },
    {
      "input": 0.00015,
      "expected": 2
    },
    {
      "input": 101.0001,
      "expected": null
    },
    {
      "input": -1,
      "expected": null
    },
    {
      "input": 1e+21,
      "expected": null
    }
  ],
