{
  "$comment": "Achievement integers (1/10000 %). toAchievementInt: string inputs are exact decimals (optional trailing %, surrounding whitespace, optional +, optional exponent); number inputs go through their shortest round-trip decimal string. Round half to even; expected null = invalid or outside 0..1010000 (never clamped). fromAchievementInt: input / 10000; formatted has exactly four fraction digits. Every integer n in 0..1010000 must also satisfy toAchievementInt(fromAchievementInt(n)) == n.",
  "version": 1,
  "toAchievementInt": [
    {
      "input": "100.5432%",
      "expected": 1005432,
      "note": "maimai NET display string"
    },
    {
      "input": "100.5432",
      "expected": 1005432
    },
    {
      "input": " 100.5432 % ",
      "expected": 1005432,
      "note": "surrounding whitespace"
    },
    {
      "input": "99.9999%",
      "expected": 999999
    },
    {
      "input": "101.0000%",
      "expected": 1010000,
      "note": "maximum"
    },
    {
      "input": "80.0000%",
      "expected": 800000
    },
    {
      "input": "0.0001%",
      "expected": 1,
      "note": "smallest step"
    },
    {
      "input": "0.0000%",
      "expected": 0
    },
    {
      "input": "0",
      "expected": 0
    },
    {
      "input": "97.12345",
      "expected": 971234,
      "note": "tie, round half to even (4 is even)"
    },
    {
      "input": "97.12355",
      "expected": 971236,
      "note": "tie, round half to even (5 is odd)"
    },
    {
      "input": "97.123450001",
      "expected": 971235,
      "note": "above the tie"
    },
    {
      "input": "97.12344999",
      "expected": 971234,
      "note": "below the tie"
    },
    {
      "input": "100.54320000",
      "expected": 1005432,
      "note": "trailing zeros"
    },
    {
      "input": "100",
      "expected": 1000000
    },
    {
      "input": "100.",
      "expected": 1000000
    },
    {
      "input": ".5",
      "expected": 5000
    },
    {
      "input": "+100.5",
      "expected": 1005000
    },
    {
      "input": "1.005432e2",
      "expected": 1005432,
      "note": "exponent form"
    },
    {
      "input": "1e-7",
      "expected": 0
    },
    {
      "input": "0.00005",
      "expected": 0,
      "note": "tie at zero rounds to even 0"
    },
    {
      "input": "0.00015",
      "expected": 2,
      "note": "tie rounds to even 2"
    },
    {
      "input": "100.99995",
      "expected": 1010000,
      "note": "tie rounds to even 1010000"
    },
    {
      "input": "101.00005",
      "expected": 1010000,
      "note": "tie rounds down to even 1010000"
    },
    {
      "input": "101.00006",
      "expected": null,
      "note": "above maximum"
    },
    {
      "input": "101.0001",
      "expected": null,
      "note": "above maximum"
    },
    {
      "input": "1000",
      "expected": null,
      "note": "above maximum"
    },
    {
      "input": "-0.0001",
      "expected": null,
      "note": "negative"
    },
    {
      "input": "-0",
      "expected": null,
      "note": "any sign other than + is rejected"
    },
    {
      "input": "",
      "expected": null
    },
    {
      "input": "%",
      "expected": null
    },
    {
      "input": ".",
      "expected": null
    },
    {
      "input": "abc",
      "expected": null
    },
    {
      "input": "100,5432",
      "expected": null,
      "note": "decimal comma"
    },
    {
      "input": "1.2.3",
      "expected": null
    },
    {
      "input": "NaN",
      "expected": null
    },
    {
      "input": "Infinity",
      "expected": null
    },
    {
      "input": "100.5432%%",
      "expected": null
    },
    {
      "input": 100.5432,
      "expected": 1005432
    },
    {
      "input": 99.9999,
      "expected": 999999
    },
    {
      "input": 101,
      "expected": 1010000
    },
    {
      "input": 101,
      "expected": 1010000
    },
    {
      "input": 80,
      "expected": 800000
    },
    {
      "input": 0.0001,
      "expected": 1
    },
    {
      "input": 0,
      "expected": 0
    },
    {
      "input": 97.12345,
      "expected": 971234,
      "note": "float, shortest decimal \"97.12345\", then round half to even"
    },
    {
      "input": 97.12355,
