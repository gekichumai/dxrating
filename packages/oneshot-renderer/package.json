{
  "name": "@gekichumai/oneshot-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "oxlint src test scripts",
    "test": "vitest run && pnpm test:runtime",
    "test:runtime": "pnpm build && node --test scripts/runtime-import.test.mjs",
    "test:visual": "node --import tsx scripts/verify-visual.ts"
  },
  "dependencies": {
    "@gekichumai/dxdata": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "clsx": "catalog:",
    "react": "catalog:",
    "satori": "0.33.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}