{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "sourceMap": true,
    "emitDeclarationOnly": true,
    "inlineSources": true
  },
  "include": ["src"]
}