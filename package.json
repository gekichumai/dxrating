{
  "name": "@gekichumai/dxrating",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm --filter @gekichumai/dxrating-web generate:routes && pnpm --filter @gekichumai/oneshot-renderer build && oxlint --type-aware . && pnpm --filter @gekichumai/backend lint:effect",
    "lint:fix": "pnpm --filter @gekichumai/dxrating-web generate:routes && pnpm --filter @gekichumai/oneshot-renderer build && oxlint --type-aware --fix ."
  },
  "devDependencies": {
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsconfig": "workspace:*",
    "turbo": "^2.9.6"
  },
  "engines": {
    "node": "26.10.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "happy-dom": ">=20.9.0",
      "flatted": ">=3.4.2",
      "effect@<4.0.0-0": "3.22.2"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "@sentry/cli",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "prisma",
      "@prisma/engines",
      "protobufjs",
      "react-grab",
      "workerd"
    ],
    "patchedDependencies": {
      "drizzle-orm@1.0.0-rc.5-5935859": "patches/drizzle-orm@1.0.0-rc.5-5935859.patch"
    }
  }
}