{
  "name": "@gekichumai/dxrating",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && pnpm --filter @gekichumai/backend lint:effect",
    "lint:fix": "oxlint --fix .",
    "test:packages": "turbo run test --filter=./packages/*",
    "test:infra": "node --test 'infra/**/*.test.{js,mts}'",
    "guard:replays": "node scripts/guard-replays/run.ts"
  },
  "devDependencies": {
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "tsconfig": "workspace:*",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "happy-dom": ">=20.9.0",
      "flatted": ">=3.4.4",
      "effect@<4.0.0-0": "3.22.4"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "@sentry/cli",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "prisma",
      "@prisma/engines",
      "protobufjs",
      "react-grab",
      "workerd"
    ],
    "patchedDependencies": {
      "drizzle-orm@1.0.0-rc.5-5935859": "patches/drizzle-orm@1.0.0-rc.5-5935859.patch"
    }
  }
}