# Ignore everything by default
*

# Only include what the backend Dockerfile needs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!patches/
!packages/tsconfig/
!packages/api-contract/
!packages/dxdata/
!packages/maimai-domain/
!packages/oneshot-renderer/
!apps/backend/

# Keep local generated artifacts out of the Docker build context.
**/.env
**/.env.*
**/node_modules
**/dist
**/.turbo
packages/oneshot-renderer/artifacts
