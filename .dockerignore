# Ignore everything by default
*

# Only include what the backend Dockerfile needs
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!packages/tsconfig/
!packages/admin-contract/
!packages/api-contract/
!packages/dxdata/
!packages/maimai-domain/
!apps/backend/

# Keep local generated artifacts out of the Docker build context.
**/node_modules
**/dist
**/.turbo

# Runtime configuration is supplied by the deployment environment. Never send
# local credentials to the Docker daemon or a remote build cache.
apps/backend/.env*
