{
  "rules": {
    "no-non-null-assertion": "off",
    "no-shadow": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/alt-text": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off"
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "plugins": ["react", "typescript", "jsx-a11y", "import"],
  "ignorePatterns": [
    "apps/web/src/paraglide",
    "dist",
    ".turbo",
    "node_modules",
    "scripts/annotator/*.json",
    "apps/web/ios",
    "apps/web/android",
    "apps/server"
  ],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/**/*.ts", "apps/backend/src/**/*.tsx"],
      "rules": {
        "gdp-ts/no-define-proof": "error",
        "gdp-ts/no-proof-assertion": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "(^|/)lxns(/index)?(\\.ts)?$",
                "message": "Use services/lxns/viewer: its functions demand a ViewerIs proof (gdp-ts)."
              },
              {
                "regex": "(^|/)proofs/viewer-is(\\.ts)?$",
                "importNames": ["viewerFromSession"],
                "message": "Only app.ts turns the request's session into a SessionViewer (gdp-ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/proofs/**"],
      "rules": {
        "gdp-ts/no-define-proof": "off",
        "gdp-ts/no-proof-assertion": "off",
        "gdp-ts/no-exported-prover": "error"
      }
    },
    {
      "files": ["apps/backend/src/services/lxns/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "(^|/)proofs/viewer-is(\\.ts)?$",
                "importNames": ["viewerFromSession"],
                "message": "Only app.ts turns the request's session into a SessionViewer (gdp-ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/app.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "(^|/)lxns(/index)?(\\.ts)?$",
                "message": "Use services/lxns/viewer: its functions demand a ViewerIs proof (gdp-ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/admin-api/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "^@gekichumai/backend(?!/(db-schema|edge-cache|http-client)$)",
                "message": "admin-api may import only @gekichumai/backend/db-schema, /edge-cache and /http-client (gekichumai/meta#50 R2.2)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}",
        "**/__tests__/**",
        "apps/backend/src/test/**",
        "apps/web/src/test-utils/**"
      ],
      "rules": {
        "test-boundaries/no-own-module-mock": "error"
      }
    },
    {
      "files": [
        "apps/backend/src/test/account-deletion.test.ts",
        "apps/backend/src/test/chart-og-image.test.ts",
        "apps/backend/src/test/cloud-save-server-imports.test.ts",
        "apps/backend/src/test/credential-hygiene-sentry-http.test.ts",
        "apps/backend/src/test/maimai-net-status.test.ts",
        "apps/backend/src/test/net-import-http.test.ts",
        "apps/backend/src/test/oneshot-renderer-http.test.ts",
        "apps/web/src/__tests__/sheets-loading.test.tsx",
        "apps/web/src/components/auth/__tests__/LoginForm.test.tsx",
        "apps/web/src/components/auth/__tests__/LoginForm.turnstile.test.tsx",
        "apps/web/src/components/global/__tests__/CatalogUnverifiedHint.test.tsx",
        "apps/web/src/components/global/__tests__/ResponsiveDialog.test.tsx",
        "apps/web/src/components/global/__tests__/SideEffector.test.tsx",
        "apps/web/src/components/global/backgrounds/__tests__/VersionBackground.test.tsx",
        "apps/web/src/components/global/preferences/__tests__/LocaleSelector.test.tsx",
        "apps/web/src/components/global/preferences/__tests__/SecuritySection.test.tsx",
        "apps/web/src/components/global/preferences/__tests__/ThemeSelector.test.tsx",
        "apps/web/src/components/global/preferences/__tests__/UserProfileModal.test.tsx",
        "apps/web/src/components/global/site-meta/__tests__/About.test.tsx",
        "apps/web/src/components/home/__tests__/HomeHub.test.tsx",
        "apps/web/src/components/layout/__tests__/AppTabs.test.tsx",
        "apps/web/src/components/layout/__tests__/ThemedBody.test.tsx",
        "apps/web/src/components/layout/__tests__/TopBar.test.tsx",
        "apps/web/src/components/rating/__tests__/RatingCalculatorAddEntryForm.test.tsx",
        "apps/web/src/components/rating/io/import/NetImportProgress.test.tsx",
        "apps/web/src/components/rating/io/import/__tests__/ImportFromLxnsButtonListItem.cloud.test.tsx",
        "apps/web/src/components/rating/io/import/__tests__/ImportFromLxnsButtonListItem.test.tsx",
        "apps/web/src/components/sheet/tags/__tests__/SheetTags.test.tsx",
        "apps/web/src/components/song/__tests__/SongHeaderAliases.test.tsx",
        "apps/web/src/components/song/hub/__tests__/songHubCatalog.test.tsx",
        "apps/web/src/hooks/__tests__/useAuth.test.tsx",
        "apps/web/src/models/__tests__/useUserRecords.test.tsx",
        "apps/web/src/models/scores/__tests__/cloudSaveActions.test.ts",
        "apps/web/src/models/scores/__tests__/fetchFeaturesSession.test.ts",
        "apps/web/src/pages/__tests__/LxnsOauthCallback.test.tsx",
        "apps/web/src/pages/__tests__/ProgressSummaryPage.test.tsx",
        "apps/web/src/pages/__tests__/RecentPage.test.tsx",
        "apps/web/src/pages/__tests__/SheetList.test.tsx",
        "apps/web/src/pages/__tests__/SongHubPage.test.tsx",
        "apps/web/src/pages/__tests__/SongPage.test.tsx",
        "apps/web/src/pages/__tests__/TrendingPage.test.tsx",
        "apps/web/src/pages/__tests__/platesFollowSiteRegion.test.tsx",
        "apps/web/src/routes/__tests__/-charts-trending.test.tsx",
        "apps/web/src/routes/__tests__/-index.test.ts",
        "apps/web/src/routes/__tests__/-song-hub-route.test.ts",
        "apps/web/src/test-utils/setup-auth.ts"
      ],
      "rules": {
        "test-boundaries/no-own-module-mock": "off"
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "gdp-ts",
      "specifier": "@gdp-ts/core/lint/plugin"
    },
    {
      "name": "test-boundaries",
      "specifier": "./scripts/lint/test-boundaries.mjs"
    }
  ]
}