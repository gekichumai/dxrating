{
  "rules": {
    "no-non-null-assertion": "off",
    "no-shadow": "off",
    "react-hooks/exhaustive-deps": "off",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/alt-text": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off"
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "plugins": ["react", "typescript", "jsx-a11y", "import"],
  "ignorePatterns": [
    "apps/web/src/paraglide",
    "dist",
    ".turbo",
    "node_modules",
    "scripts/annotator/*.json",
    "apps/web/ios",
    "apps/web/android",
    "apps/server"
  ],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.ts", "apps/web/src/**/*.tsx"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "localStorage",
            "message": "Use persisted(key, schema, fallback) from @/utils/persisted; a module that keeps its own stored format takes browserStorage(area) from there."
          },
          {
            "name": "sessionStorage",
            "message": "Use persisted(key, schema, fallback) from @/utils/persisted; a module that keeps its own stored format takes browserStorage(area) from there."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "window",
            "property": "localStorage",
            "message": "Use persisted(key, schema, fallback) from @/utils/persisted; a module that keeps its own stored format takes browserStorage(area) from there."
          },
          {
            "object": "window",
            "property": "sessionStorage",
            "message": "Use persisted(key, schema, fallback) from @/utils/persisted; a module that keeps its own stored format takes browserStorage(area) from there."
          },
          {
            "object": "globalThis",
            "property": "localStorage",
            "message": "Use persisted(key, schema, fallback) from @/utils/persisted; a module that keeps its own stored format takes browserStorage(area) from there."
          },
          {
            "object": "globalThis",
            "property": "sessionStorage",
            "message": "Use persisted(key, schema, fallback) from @/utils/persisted; a module that keeps its own stored format takes browserStorage(area) from there."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-use",
                "importNames": ["useLocalStorage", "useSessionStorage"],
                "message": "Use usePersisted(persisted(key, schema, fallback)) from @/utils/persisted: react-use casts the stored JSON without checking it."
              }
            ],
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/web/src/utils/persisted.ts",
        "apps/web/src/**/__tests__/**",
        "apps/web/src/**/*.test.ts",
        "apps/web/src/**/*.test.tsx"
      ],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      "files": ["apps/backend/src/**/*.ts", "apps/backend/src/**/*.tsx"],
      "rules": {
        "gdp-ts/no-define-proof": "error",
        "gdp-ts/no-proof-assertion": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "(^|/)lxns(/index)?(\\.ts)?$",
                "message": "Use services/lxns/viewer: its functions demand a ViewerIs proof (gdp-ts)."
              },
              {
                "regex": "(^|/)proofs/viewer-is(\\.ts)?$",
                "importNames": ["viewerFromSession"],
                "message": "Only app.ts turns the request's session into a SessionViewer (gdp-ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/proofs/**"],
      "rules": {
        "gdp-ts/no-define-proof": "off",
        "gdp-ts/no-proof-assertion": "off",
        "gdp-ts/no-exported-prover": "error"
      }
    },
    {
      "files": ["apps/backend/src/services/lxns/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "(^|/)proofs/viewer-is(\\.ts)?$",
                "importNames": ["viewerFromSession"],
                "message": "Only app.ts turns the request's session into a SessionViewer (gdp-ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/app.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "(^|/)lxns(/index)?(\\.ts)?$",
                "message": "Use services/lxns/viewer: its functions demand a ViewerIs proof (gdp-ts)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/backend/src/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/admin-api/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}/.*\\.js$",
                "message": "Use extensionless relative imports in TypeScript source."
              },
              {
                "regex": "^@gekichumai/backend(?!/(db-schema|edge-cache|http-client)$)",
                "message": "admin-api may import only @gekichumai/backend/db-schema, /edge-cache and /http-client (gekichumai/meta#50 R2.2)."
              }
            ]
          }
        ]
      }
    }
  ],
  "jsPlugins": [
    {
      "name": "gdp-ts",
      "specifier": "@gdp-ts/core/lint/plugin"
    }
  ]
}