DATABASE_URL="postgres://postgres:postgres@localhost:5432/dxrating"

# Dedicated migration job safety limits (defaults shown)
MIGRATION_LOCK_TIMEOUT_MS=60000
MIGRATION_LOCK_RETRY_MS=250
MIGRATION_CONNECTION_TIMEOUT_MS=10000
MIGRATION_SQL_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=900000

BETTER_AUTH_SECRET="changeme_secret_1234567890"
BETTER_AUTH_URL="http://localhost:3000"

# Passkey / WebAuthn (set these in production when frontend and backend are on different domains)
PASSKEY_RP_ID=""
PASSKEY_ORIGIN=""

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=""

# LXNS OAuth (maimai.lxns.net)
LXNS_CLIENT_ID=""
LXNS_CLIENT_SECRET=""

# Frontend URL (used for OAuth redirects back to the frontend)
FRONTEND_URL="http://localhost:5173"

# PostHog (for analytics API queries)
POSTHOG_PROJECT_ID=""
POSTHOG_API_KEY=""
