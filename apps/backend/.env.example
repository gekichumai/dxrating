DATABASE_URL="postgres://postgres:postgres@localhost:5432/dxrating"

# Dedicated migration job safety limits (defaults shown)
MIGRATION_LOCK_TIMEOUT_MS=60000
MIGRATION_LOCK_RETRY_MS=250
MIGRATION_CONNECTION_TIMEOUT_MS=10000
MIGRATION_SQL_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=900000

BETTER_AUTH_SECRET="changeme_secret_1234567890"
BETTER_AUTH_URL="http://localhost:3000"
# Deployment-managed immutable Better Auth user IDs. Application code cannot edit this list.
SUPER_ADMIN_USER_IDS='[]'
# Advance this UTC timestamp whenever the ID list changes. It is required for a non-empty list.
SUPER_ADMIN_USER_IDS_EFFECTIVE_AT=''

# Passkey / WebAuthn (set these in production when frontend and backend are on different domains)
PASSKEY_RP_ID=""
PASSKEY_ORIGIN=""

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=""

# LXNS OAuth (maimai.lxns.net)
LXNS_CLIENT_ID=""
LXNS_CLIENT_SECRET=""

# Frontend URL (used for OAuth redirects back to the frontend)
FRONTEND_URL="http://localhost:5173"
# Exact public preview/development origins. These receive ordinary browser API
# and authentication CORS access, never administrator-route CORS access.
PUBLIC_ADDITIONAL_TRUSTED_ORIGINS='[]'
# Standalone administrator frontend. Additional entries are exact origins in a
# JSON array; wildcard and suffix patterns are intentionally unsupported.
ADMIN_FRONTEND_URL="http://localhost:5174"
ADMIN_ADDITIONAL_TRUSTED_ORIGINS='[]'
# Local/test-only Access substitute. A local reverse proxy must inject this
# server-side; never expose the secret through a VITE_ browser variable.
ADMIN_ACCESS_MODE="test_bypass"
ADMIN_ACCESS_TEST_BYPASS_SECRET="change-me-local-only-admin-access-proof"
# Cloudflare mode instead requires an exact team origin and explicit audience
# tags. Leave these unset while using test_bypass mode.
ADMIN_ACCESS_ISSUER=""
ADMIN_ACCESS_AUDIENCES='[]'

# Transitional only: set to the former parent Domain while moving existing
# authentication cookies to backend-host-only scope, then remove after one
# maximum session lifetime.
LEGACY_AUTH_COOKIE_DOMAIN=""

# PostHog (for analytics API queries)
POSTHOG_PROJECT_ID=""
POSTHOG_API_KEY=""
