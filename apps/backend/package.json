{
  "name": "@gekichumai/backend",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts src/migrate.ts --bundle --outdir=dist --platform=node --target=node25 --format=esm --packages=external --jsx=automatic --sourcemap",
    "start": "node dist/index.js",
    "migrate": "node --enable-source-maps --experimental-transform-types dist/migrate.js",
    "migrate:dev": "tsx --env-file-if-exists=.env.local src/migrate.ts",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:migrations": "pnpm build:bundle && MIGRATION_COMPILED_TEST=1 vitest run src/db/migration-config.test.ts src/db/migration-runner.test.ts src/db/backfill-runner.test.ts src/db/migration-cli.integration.test.ts src/db/admin-role-migration.test.ts src/db/admin-primary-auth-migration.test.ts src/db/admin-session-transition-migration.test.ts",
    "test:producer-contract": "DXDATA_PRODUCER_CONTRACT=1 vitest run src/test/dxdata-producer-contract.test.ts",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@better-auth/i18n": "^1.6.11",
    "@better-auth/passkey": "catalog:",
    "@gekichumai/admin-contract": "workspace:*",
    "@gekichumai/api-contract": "workspace:*",
    "@gekichumai/dxdata": "workspace:*",
    "@gekichumai/maimai-domain": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/hono-api-reference": "^0.10.8",
    "@sentry/node": "^10.70.0",
    "@simplewebauthn/server": "^13.3.0",
    "@takumi-rs/image-response": "1.1.2",
    "@types/react": "catalog:",
    "bcrypt": "^6.0.0",
    "better-auth": "catalog:",
    "clsx": "catalog:",
    "cookie": "^1.1.1",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.13.0",
    "hono": "catalog:",
    "jose": "6.2.0",
    "keyv": "^5.6.0",
    "pg": "catalog:",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "ts-pattern": "catalog:",
    "undici": "^7.25.0",
    "xmldom-qsa": "^1.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}