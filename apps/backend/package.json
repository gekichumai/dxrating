{
  "name": "@gekichumai/backend",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db-schema": "./src/db/schema.ts",
    "./edge-cache": "./src/services/edge-cache.ts",
    "./http-client": "./src/services/http-client.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @gekichumai/oneshot-renderer build && tsx watch src/index.ts",
    "build": "pnpm lint:effect && tsc && pnpm build:bundle",
    "build:bundle": "esbuild src/index.ts src/migrate.ts src/flag-set.ts src/net-login-probe.ts --bundle --outdir=dist --platform=node --target=node26 --format=esm --packages=external --jsx=automatic --sourcemap",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "oxlint . && pnpm lint:effect",
    "test": "vitest run",
    "test:producer-contract": "DXDATA_PRODUCER_CONTRACT=1 vitest run src/test/dxdata-producer-contract.test.ts",
    "test:watch": "vitest",
    "flag:set": "tsx src/flag-set.ts",
    "test:migration-roundtrip": "tsx scripts/migration-roundtrip.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:source-context": "node --test scripts/test-sentry-source-context.mjs",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@better-auth/i18n": "1.7.6",
    "@better-auth/passkey": "catalog:",
    "@effect/opentelemetry": "4.0.0-rc.118",
    "@effect/platform-node": "4.0.0-rc.118",
    "@effect/sql-pg": "4.0.0-rc.118",
    "@gdp-ts/core": "0.1.0",
    "@gekichumai/api-contract": "workspace:*",
    "@gekichumai/dxdata": "workspace:*",
    "@gekichumai/maimai-domain": "workspace:*",
    "@gekichumai/oneshot-renderer": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/server": "2.4.0",
    "@openapi-spec/types": "0.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@orpc/contract": "catalog:",
    "@orpc/experimental-effect": "2.0.0-beta.40",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@scalar/hono-api-reference": "^0.10.8",
    "@sentry/node": "^10.70.0",
    "@simplewebauthn/server": "^13.3.3",
    "@takumi-rs/image-response": "1.1.2",
    "@types/react": "catalog:",
    "bcrypt": "^6.0.0",
    "better-auth": "catalog:",
    "clsx": "catalog:",
    "cookie": "^1.1.1",
    "dotenv": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0-rc.118",
    "evlog": "^2.34.0",
    "hono": "catalog:",
    "pg": "catalog:",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "sharp": "0.35.5",
    "ts-pattern": "catalog:",
    "undici": "^7.30.1",
    "xmldom-qsa": "^1.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.46.1",
    "@effect/vitest": "4.0.0-rc.118",
    "@modelcontextprotocol/client": "2.4.0",
    "@orpc/client": "catalog:",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}