{
  "name": "@gekichumai/backend",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts src/migrate.ts --bundle --outdir=dist --platform=node --target=node25 --format=esm --packages=external --jsx=automatic --sourcemap",
    "start": "node dist/index.js",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:producer-contract": "DXDATA_PRODUCER_CONTRACT=1 vitest run src/test/dxdata-producer-contract.test.ts",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@better-auth/i18n": "^1.6.11",
    "@better-auth/passkey": "catalog:",
    "@gekichumai/api-contract": "workspace:*",
    "@gekichumai/dxdata": "workspace:*",
    "@gekichumai/maimai-domain": "workspace:*",
    "@hono/node-server": "^1.19.17",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/hono-api-reference": "^0.12.0",
    "@sentry/node": "^10.70.0",
    "@simplewebauthn/server": "^13.3.3",
    "@takumi-rs/image-response": "1.8.7",
    "@types/react": "catalog:",
    "bcrypt": "^6.0.0",
    "better-auth": "catalog:",
    "clsx": "catalog:",
    "cookie": "^1.1.1",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.28.0",
    "hono": "catalog:",
    "keyv": "^5.6.0",
    "pg": "catalog:",
    "postgres": "^3.4.9",
    "react": "catalog:",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "ts-pattern": "catalog:",
    "undici": "^7.29.0",
    "xmldom-qsa": "^1.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}