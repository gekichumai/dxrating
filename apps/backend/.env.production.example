# PostgreSQL bootstrap account used only by the database container
POSTGRES_USER=dxrating
POSTGRES_PASSWORD=CHANGE_ME_BOOTSTRAP_ONLY
POSTGRES_DB=dxrating
# Stable external Docker network shared by PostgreSQL, traffic, and the
# protected one-shot migration runner. Create it before the first deployment.
DATABASE_DOCKER_NETWORK=dxrating-database

# Backend
# Set both values to the exact sha256 digest emitted by the reviewed image
# build. The migration value is used only by the explicit operator overlay;
# the traffic stack receives only the backend value. Tags, including
# full-commit tags, are not release identities.
MIGRATION_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
BACKEND_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEXADECIMAL_CHARACTERS
MIGRATION_DATABASE_URL=postgres://dxrating_migrator:CHANGE_ME_MIGRATOR@postgres:5432/dxrating
DATABASE_URL=postgres://dxrating_app:CHANGE_ME_APPLICATION@postgres:5432/dxrating
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
BETTER_AUTH_URL=https://YOUR_BACKEND_HOST
# JSON array of immutable Better Auth user IDs; changing it requires a deployment.
SUPER_ADMIN_USER_IDS=[]
FRONTEND_URL=https://YOUR_FRONTEND_HOST
# Exact HTTPS public preview origins. Keep these separate from administrator
# preview origins so they never receive administrator-route CORS access.
PUBLIC_ADDITIONAL_TRUSTED_ORIGINS=[]
ADMIN_FRONTEND_URL=https://admin.dxrating.net
# Exact, access-protected HTTPS origins only. Use same-site preview hosts so
# SameSite=Lax authentication cookies are sent to the backend.
ADMIN_ADDITIONAL_TRUSTED_ORIGINS=[]
ADMIN_ACCESS_MODE=cloudflare
ADMIN_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
# Exact production and protected-preview Access application audience tags.
ADMIN_ACCESS_AUDIENCES=["REPLACE_WITH_CLOUDFLARE_ACCESS_AUDIENCE_TAG"]
# Transitional only during the host-only cookie rollout; remove after one
# maximum session lifetime. Example for the prior deployment: dxrating.net
LEGACY_AUTH_COOKIE_DOMAIN=
PORT=3000

# Dedicated one-shot migration job safety limits (defaults shown)
MIGRATION_LOCK_TIMEOUT_MS=60000
MIGRATION_LOCK_RETRY_MS=250
MIGRATION_CONNECTION_TIMEOUT_MS=10000
MIGRATION_SQL_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=900000

# Optional: OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: passkeys / WebAuthn
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# Optional: Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY=

# Optional: LXNS OAuth
LXNS_CLIENT_ID=
LXNS_CLIENT_SECRET=

# Optional: analytics and error reporting
POSTHOG_PROJECT_ID=
POSTHOG_API_KEY=
SENTRY_DSN=
SENTRY_RELEASE=

# Optional: renderer assets and file-backed secret loading
ASSETS_LOCAL_CACHE_DIR=
ASSETS_REMOTE_URL=
VAULT_SECRET_PATH=
