# admin-api (gekichumai/meta#50). Names only; never commit values.
# Unset means production. Local development sets this explicitly (pnpm dev does too).
NODE_ENV=development
PORT=3100
# The admin host's origin (the SPA); browser requests from any other origin are refused
ADMIN_ORIGIN=http://localhost:5180
# Cloudflare Access team domain and the admin Access application's AUD tag (required in production)
ADMIN_ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=
# Comma-separated emails allowed in; repeats the Access policy inside the app. Empty means nobody.
ADMIN_HUMAN_EMAILS=
# Development only: act as this Access identity without Cloudflare (refused outside NODE_ENV=development)
ADMIN_DEV_ACCESS_EMAIL=
# Agent tokens: JSON list of {principal, sha256, scopes, expiresAt, accessCommonName?}; make entries with pnpm token:new
ADMIN_AGENT_TOKENS=
# Requests per minute per agent (destructive scopes get a fifth)
ADMIN_AGENT_RATE_LIMIT=60
# Postgres as the restricted role dxrating_admin (required in production)
DATABASE_URL=
# Edge cache purge for the public announcements list (both unset skips it)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CACHE_PURGE_TOKEN=
# Tests only: a throwaway Postgres for the announcements integration tests
ADMIN_API_TEST_DATABASE_URL=
