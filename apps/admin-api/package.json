{
  "name": "@gekichumai/admin-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "pnpm lint:effect && tsc && pnpm build:bundle",
    "build:bundle": "node scripts/bundle.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "oxlint . && pnpm lint:effect",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning",
    "test": "vitest run",
    "token:new": "tsx scripts/new-agent-token.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@orpc/contract": "catalog:",
    "@orpc/experimental-effect": "2.0.0-beta.40",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0-rc.118",
    "hono": "catalog:",
    "jose": "6.2.12",
    "pg": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.46.1",
    "@gekichumai/api-contract": "workspace:*",
    "@gekichumai/backend": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}