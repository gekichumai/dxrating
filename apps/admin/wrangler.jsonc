{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // admin.dxrating.net (gekichumai/meta#50 L3). Deployed by .github/workflows/admin.yml once the owner has set up
  // Cloudflare Access for this host (see the L3 PR for the steps).
  "name": "dxrating-admin",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-13",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.dxrating.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": { "ADMIN_API_ORIGIN": "https://admin-api.dxrating.net" },
}