# Optional non-secret label shown beside the wordmark outside production.
VITE_ADMIN_ENVIRONMENT=local
# Browser-facing backend origin. Local development uses the Vite server-side proxy.
# Use HTTPS outside local development and never place secrets here.
VITE_BACKEND_URL=http://localhost:5174
# Public site key paired with TURNSTILE_SECRET_KEY; leave empty when CAPTCHA is disabled.
VITE_TURNSTILE_SITE_KEY=
